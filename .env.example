# --- Vision AI + copywriting (required for live analysis) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Vision-capable model used for design scoring + menu extraction
OPENROUTER_VISION_MODEL=anthropic/claude-sonnet-4.5
# Text model used for postcard copy
OPENROUTER_TEXT_MODEL=anthropic/claude-sonnet-4.5

# --- Discovery (optional; falls back to data/seed-restaurants.json) ---
# https://developers.google.com/maps/documentation/places/web-service
GOOGLE_PLACES_API_KEY=

# --- Deployment (optional; without it apps are built to out/<slug>/app for any static host) ---
# https://vercel.com/account/tokens
VERCEL_TOKEN=
# Base URL used on QR codes when no deploy target is configured
PUBLIC_BASE_URL=https://menus.example.com

# --- Direct mail (required for fulfillment) ---
# https://dashboard.lob.com/settings/api-keys  (use test_ key first!)
LOB_API_KEY=

# --- Sender identity printed on the postcard ---
FROM_NAME=Chris
FROM_COMPANY=Plate & Pixel
FROM_ADDRESS_LINE1=123 Main St
FROM_CITY=Austin
FROM_STATE=TX
FROM_ZIP=78701

# Ugliness threshold (1-10). Sites scoring >= this get the full treatment.
UGLINESS_THRESHOLD=6
